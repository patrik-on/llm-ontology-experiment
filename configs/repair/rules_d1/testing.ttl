# D1 base for the repair-loop pilot: T3 copied unchanged from
# thesis_materials/2026-11-23_navrh_slucka_c_d/shapes_testing.ttl (T1, T2, T4 are not in the pilot).
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix lo:   <https://w3id.org/llm-ontology/project#> .
@prefix los:  <https://w3id.org/llm-ontology/shapes#> .

los: a owl:Ontology ;
  sh:declare [ sh:prefix "lo" ; sh:namespace "https://w3id.org/llm-ontology/project#"^^xsd:anyURI ] .

# T3 – Chyba: test má overiť úspešné pridanie prvku, ale pripraví zoznam pevnej veľkosti alebo
#      nemeniteľný zoznam. Samotný typ List to nerozhodne, rozhoduje operácia, ktorú metóda nad
#      argumentom vykoná (lo:mutatedBy), a to, či ju pripravený objekt podporuje (lo:resultMutability).
#      Vyhodnotiteľné iba vtedy, keď sa mutácia vykoná na úspešnej ceste metódy a test nečaká výnimku
#      (assertThrows na UnsupportedOperationException je správne použitie nemeniteľného zoznamu).
#      Inak je výsledok „nevieme posúdiť“ (sh:Info) a do spätnej väzby nejde.
los:T3_MutatedParameterNeedsMutableArgument a sh:NodeShape ;
  sh:targetClass lo:Argument ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:prefixes los: ;
    sh:severity sh:Violation ;
    sh:message "T3 argument {?pos} of {?display} (test body {?body}, line {?line}) comes from {?factory}, which is {?mut}; {?method} always calls {?op}() on parameter '{?pname}' when it succeeds. Pass a mutable collection, e.g. new {?impl}<>(...)." ;
    sh:select """
      SELECT $this ?pos ?display ?body ?line ?factory ?mut ?method ?pname ?op ?impl WHERE {
        $this lo:argumentOf ?call ; lo:position ?pos ; lo:producedBy ?fac .
        FILTER NOT EXISTS { $this lo:inExpectedException true }
        ?fac lo:factoryName ?factory ; lo:resultMutability ?m ; lo:mutableAlternative ?impl .
        FILTER (?m IN (lo:Immutable, lo:FixedSize))
        BIND (IF(?m = lo:Immutable, "immutable", "fixed-size") AS ?mut)
        ?call lo:resolvesTo ?e ; lo:display ?display ; lo:inBody ?body ; lo:line ?line .
        ?e lo:name ?method ; lo:mutatesParameter ?p .
        ?p lo:position ?pos ; lo:name ?pname ; lo:mutatedBy ?op ; lo:mutationOnSuccessPath true .
        FILTER (?m = lo:Immutable || ?op IN ("add", "addAll", "remove", "removeIf", "clear", "retainAll", "removeAll"))
      }""" ;
  ] .

# „Nevieme posúdiť“: samostatný tvar so závažnosťou sh:Info (v SHACL sa závažnosť určuje na tvare).
# Výsledky sa zaznamenajú, ale do spätnej väzby modelu nejdú.
los:T3_Undecided a sh:NodeShape ;
  sh:targetClass lo:Argument ;
  sh:severity sh:Info ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:prefixes los: ;
   
    sh:message "T3 UNDECIDED for argument {?pos} of {?display} (test body {?body}, line {?line}): {?why}." ;
    sh:select """
      SELECT $this ?pos ?display ?body ?line ?why WHERE {
        $this lo:argumentOf ?call ; lo:position ?pos ; lo:producedBy ?fac .
        FILTER NOT EXISTS { $this lo:inExpectedException true }
        ?fac lo:resultMutability ?m .
        ?call lo:resolvesTo ?e ; lo:display ?display ; lo:inBody ?body ; lo:line ?line .
        ?e lo:mutatesParameter ?p . ?p lo:position ?pos .
        OPTIONAL { ?p lo:mutationOnSuccessPath ?onPath }
        BIND (IF(?m = lo:UnknownMutability, "the origin of the argument is not known, so its mutability is unknown",
              IF(?m IN (lo:Immutable, lo:FixedSize) && (!BOUND(?onPath) || ?onPath = false),
                 "the method mutates the parameter only in some branches", "")) AS ?why)
        FILTER (?why != "")
      }""" ;
  ] .

