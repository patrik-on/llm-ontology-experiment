{"id":"testing_medium_003","task":"testing","difficulty":"medium","title":"First matching product lookup","input":{"kind":"testing","class_name":"ProductCatalog","source_code":"import java.util.List;\n\nfinal class ProductCatalog {\n    String findFirst(List<String> products, String query) {\n        if (products == null || query == null) {\n            return null;\n        }\n        for (String product : products) {\n            if (query.equals(product)) {\n                return product;\n            }\n        }\n        return null;\n    }\n}","focal_method":"findFirst","test_framework":"JUnit 5","package_name":"","imports":["java.util.List"],"requirements":"Cover a match, no match, empty collection, and supported null inputs.","fixture_path":"data/smoke/testing/fixtures/testing_medium_003/Input.java"},"expected_process":["identify first-match and null contracts","cover present and absent values","cover empty and null collections"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"findFirst","minimum_test_methods":4,"required_scenarios":["matching element","missing element","empty list","null input"],"expected_exception_types":[]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"findFirst"},{"rule":"minimum_test_methods","value":4},{"rule":"required_scenarios","value":["match","no match","empty list","null"]}],"tags":["collections","nullable","search"],"notes":"The method deliberately returns null rather than Optional.","input_code_hash":"30a7d8f92f4a09937d257c8d1d7bf843ade7fd40b4249460351f885fd7639390","normalized_input_code_hash":"c6880a475d9ebce99658e3f3514449e15bdf5fa0543543f968b849146753d7ad","focal_method_hash":"c6880a475d9ebce99658e3f3514449e15bdf5fa0543543f968b849146753d7ad"}
{"id":"testing_medium_004","task":"testing","difficulty":"medium","title":"Whitespace and case normalization","input":{"kind":"testing","class_name":"TextNormalizer","source_code":"import java.util.Locale;\n\nfinal class TextNormalizer {\n    String normalize(String value) {\n        if (value == null || value.isBlank()) {\n            return \"\";\n        }\n        return value.trim().toLowerCase(Locale.ROOT).replaceAll(\"\\\\s+\", \" \").trim();\n    }\n}","focal_method":"normalize","test_framework":"JUnit 5","package_name":"","imports":["java.util.Locale"],"requirements":"Cover null, blank, mixed case, and repeated whitespace.","fixture_path":"data/smoke/testing/fixtures/testing_medium_004/Input.java"},"expected_process":["identify null and blank handling","cover Locale.ROOT lowercasing","verify whitespace collapse"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"normalize","minimum_test_methods":4,"required_scenarios":["null input","blank input","mixed case","repeated whitespace"],"expected_exception_types":[]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"normalize"},{"rule":"minimum_test_methods","value":4},{"rule":"required_scenarios","value":["null","blank","case","whitespace"]}],"tags":["strings","nullable","normalization"],"notes":"Locale.ROOT makes the case conversion deterministic.","input_code_hash":"bf1452d49fa6d49b83447cd93a632081ee94d698d12a7702bd71dfdfc8cf7436","normalized_input_code_hash":"0e6494ddc80ee2de8eed0017f5aff25eb907e722f26697ebe9fcb4db7b0fc59d","focal_method_hash":"0e6494ddc80ee2de8eed0017f5aff25eb907e722f26697ebe9fcb4db7b0fc59d"}
{"id":"testing_tricky_001","task":"testing","difficulty":"tricky","title":"Bounded mutable counter","input":{"kind":"testing","class_name":"BoundedCounter","source_code":"final class BoundedCounter {\n    private int value;\n\n    BoundedCounter(int initial) {\n        if (initial < 0) {\n            throw new IllegalArgumentException(\"negative initial value\");\n        }\n        value = initial;\n    }\n\n    int increment(int limit) {\n        if (limit < 0) {\n            throw new IllegalArgumentException(\"negative limit\");\n        }\n        if (value < limit) {\n            value++;\n        }\n        return value;\n    }\n\n    int decrement() {\n        if (value > 0) {\n            value--;\n        }\n        return value;\n    }\n\n    int value() {\n        return value;\n    }\n}","focal_method":"increment","test_framework":"JUnit 5","package_name":"","imports":[],"requirements":"Verify state over repeated calls, upper and lower bounds, and invalid arguments.","fixture_path":"data/smoke/testing/fixtures/testing_tricky_001/Input.java"},"expected_process":["identify mutable state and bounds","exercise repeated increments and decrements","assert invalid constructor or limit arguments"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"increment","minimum_test_methods":5,"required_scenarios":["state changes across calls","increment stops at limit","decrement stops at zero","negative initial value","negative limit"],"expected_exception_types":["IllegalArgumentException"]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"increment"},{"rule":"minimum_test_methods","value":5},{"rule":"expected_exception_asserted","value":"IllegalArgumentException"},{"rule":"required_scenarios","value":["state","upper bound","lower bound","invalid inputs"]}],"tags":["stateful","boundary","exception"],"notes":"Each test should create its own counter to avoid order dependence.","input_code_hash":"08eaa45735e5b176d3c378de5f9b66b554ea63b349d0f1acb53d248dab99442e","normalized_input_code_hash":"bb4108ab2c77a1fa9e3c64780514f77f1798a6f4a1dd77458b76697477e11302","focal_method_hash":"60efda54821ee8ffc4cf36a67393eb9f5619c17b092d3021fe065d45cfdb694b"}
{"id":"testing_tricky_002","task":"testing","difficulty":"tricky","title":"Tiered shipping fee","input":{"kind":"testing","class_name":"ShippingFee","source_code":"final class ShippingFee {\n    int calculate(int orderCents, boolean express, boolean member) {\n        if (orderCents < 0) {\n            throw new IllegalArgumentException(\"negative order total\");\n        }\n        if (orderCents >= 5000) {\n            return 0;\n        }\n        int fee = express ? 1200 : 500;\n        if (member) {\n            fee -= 200;\n        }\n        return Math.max(fee, 0);\n    }\n}","focal_method":"calculate","test_framework":"JUnit 5","package_name":"","imports":[],"requirements":"Cover free shipping, regular/express fees, membership discount, and invalid totals.","fixture_path":"data/smoke/testing/fixtures/testing_tricky_002/Input.java"},"expected_process":["map all independent decision branches","cover the exact free-shipping threshold","assert invalid total handling"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"calculate","minimum_test_methods":6,"required_scenarios":["regular non-member","regular member","express non-member","express member","free-shipping threshold","negative total"],"expected_exception_types":["IllegalArgumentException"]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"calculate"},{"rule":"minimum_test_methods","value":6},{"rule":"expected_exception_asserted","value":"IllegalArgumentException"},{"rule":"required_scenarios","value":["fee branches","membership","threshold","invalid total"]}],"tags":["branching","threshold","exception"],"notes":"Amounts are integer cents, avoiding floating-point ambiguity.","input_code_hash":"47820570bca7d0867aff132cf17c5eb976279e414f61292615ef62d69ec1de92","normalized_input_code_hash":"5ad3fed7d176c0e9910e8f60ce03d220a596b507ac059db88418c563c8d9f6ff","focal_method_hash":"5ad3fed7d176c0e9910e8f60ce03d220a596b507ac059db88418c563c8d9f6ff"}
{"id":"testing_tricky_003","task":"testing","difficulty":"tricky","title":"Validated string window slicing","input":{"kind":"testing","class_name":"WindowSlice","source_code":"final class WindowSlice {\n    String slice(String value, int start, int length) {\n        if (value == null) {\n            throw new IllegalArgumentException(\"value is null\");\n        }\n        if (start < 0 || length < 0 || start > value.length() - length) {\n            throw new IndexOutOfBoundsException(\"invalid window\");\n        }\n        return value.substring(start, start + length);\n    }\n}","focal_method":"slice","test_framework":"JUnit 5","package_name":"","imports":[],"requirements":"Cover zero length, end boundary, and each invalid-input family.","fixture_path":"data/smoke/testing/fixtures/testing_tricky_003/Input.java"},"expected_process":["identify the valid index relation","cover zero-length and end-aligned windows","assert null and index exception types"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"slice","minimum_test_methods":6,"required_scenarios":["middle slice","end boundary","zero length","negative start or length","window beyond end","null value"],"expected_exception_types":["IllegalArgumentException","IndexOutOfBoundsException"]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"slice"},{"rule":"minimum_test_methods","value":6},{"rule":"expected_exception_asserted","value":["IllegalArgumentException","IndexOutOfBoundsException"]},{"rule":"required_scenarios","value":["valid window","boundaries","negative index","overflow window","null"]}],"tags":["indexes","strings","exceptions"],"notes":"The subtraction-based bounds check avoids start+length integer overflow.","input_code_hash":"afd2145208fdf5a5b53fbb47450fb67fea9d3fed567517e61614a40ba8a0ffd4","normalized_input_code_hash":"2d95e22d6d9c126ec683763e2366c490059ba474c259d77fc03eff2a46d094d6","focal_method_hash":"2d95e22d6d9c126ec683763e2366c490059ba474c259d77fc03eff2a46d094d6"}
{"id":"testing_tricky_004","task":"testing","difficulty":"tricky","title":"Score ledger state and immutable view","input":{"kind":"testing","class_name":"ScoreLedger","source_code":"import java.util.ArrayList;\nimport java.util.List;\n\nfinal class ScoreLedger {\n    private final List<Integer> scores = new ArrayList<>();\n\n    void addScore(int score) {\n        if (score < 0 || score > 100) {\n            throw new IllegalArgumentException(\"score outside 0..100\");\n        }\n        scores.add(score);\n    }\n\n    List<Integer> scores() {\n        return List.copyOf(scores);\n    }\n\n    double average() {\n        return scores.stream().mapToInt(Integer::intValue).average().orElse(0.0);\n    }\n}","focal_method":"addScore","test_framework":"JUnit 5","package_name":"","imports":["java.util.ArrayList","java.util.List"],"requirements":"Verify state, average, input bounds, and immutability of the returned list.","fixture_path":"data/smoke/testing/fixtures/testing_tricky_004/Input.java"},"expected_process":["identify score bounds and mutable internal state","verify derived average after multiple calls","verify returned list cannot mutate the ledger"],"expected_output":{"kind":"testing","must_compile":true,"must_use_framework":"JUnit 5","must_call_method":"addScore","minimum_test_methods":5,"required_scenarios":["empty average","multiple scores and average","boundary scores 0 and 100","out-of-range score","immutable returned list"],"expected_exception_types":["IllegalArgumentException","UnsupportedOperationException"]},"validation_rules":[{"rule":"code_compiles","value":null},{"rule":"generated_tests_pass","value":null},{"rule":"invokes_focal_method","value":"addScore"},{"rule":"minimum_test_methods","value":5},{"rule":"expected_exception_asserted","value":["IllegalArgumentException","UnsupportedOperationException"]},{"rule":"required_scenarios","value":["empty state","state accumulation","score boundaries","immutable view"]}],"tags":["stateful","collections","immutability"],"notes":"The list returned by scores is an immutable snapshot.","input_code_hash":"c305759565a36cf2bf1797ecbaf61d9c776097af2c18e5e178cd2c7e352acddb","normalized_input_code_hash":"0ab4461239f28bafca0197dc73125f26c43bfe3812f25f194f08ce65a506e2ff","focal_method_hash":"4602e8e9b30c568685c5f39f573fc8dc0e71f37a1598b0f6362e8b0910fef3b3"}
