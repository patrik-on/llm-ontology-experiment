# Optional shell defaults. The project does not auto-load this file;
# export the variables in your shell (e.g. ~/.bashrc in WSL) before running.
OLLAMA_BASE_URL=http://localhost:11434
LLM_ONTOLOGY_EXPERIMENTS_ROOT=~/experiments/llm-ontology

# Machine-specific roots used as ${...} placeholders in configs/.
# Defaults (used when unset) match the original WSL setup.
LLM_ONTOLOGY_WORK_ROOT=~/benchmark-work          # JDKs, JUnit/JaCoCo jars, git mirrors, scratch builds
LLM_ONTOLOGY_MODELS_ROOT=/mnt/c/models           # Hugging Face model snapshots
LLM_ONTOLOGY_DATASETS_ROOT=/mnt/c/datasets       # large raw datasets (ML4Refactoring)
